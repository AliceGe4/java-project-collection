<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alicegerman.bullseye.BullseyeController">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" prefWidth="800.0" text="Bullseye Game" textAlignment="CENTER" wrapText="true" VBox.vgrow="NEVER">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" prefWidth="500.0" text="Instruction: Pick a number made of 4 numerical digits where each digit is different. Try and match to the random number, bullseye mean you hit the right location, hits mean you struck gold but not at the correct place!" textAlignment="CENTER" wrapText="true" />
      <HBox alignment="CENTER" prefHeight="131.0" prefWidth="700.0">
         <children>
            <TextField fx:id="guessField" prefWidth="142.0" />
            <Button mnemonicParsing="false" onAction="#handleGuess" text="Guess" />
         </children>
      </HBox>
      <Label text="Result:" />
      <Label fx:id="resultLabel" text="Waiting for guess..." />
      <Label alignment="BOTTOM_RIGHT" contentDisplay="BOTTOM" text="History:" />
      <TextArea fx:id="historyArea" editable="false" prefHeight="200.0" prefWidth="250.0" wrapText="true" />
      <Button fx:id="newGameButton" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#handleNewGame" text="New Game" />
   </children>
</VBox>
